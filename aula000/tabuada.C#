using System;

class Program
{
    static void Main()
    {
        Console.WriteLine("Olá, Mundo!");
        
        Console.Write("Digite um número: ");
        int numero = Convert.ToInt32(Console.ReadLine());
        
        for (int i = 1; i <= 10; i++)
        {
            Console.WriteLine($"{numero} x {i} = {numero * i}");
        }
    }
}
